# EditorConfig is awesome: https://editorconfig.org

# Top-most EditorConfig file
root = true

# UTF-8 and Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.java]
indent_size = 2
indent_style = space
max_line_length = 100
tab_width = 2
